<Window x:Class="LensCleaner.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LensCleaner.ViewModels"
        xmlns:views="using:LensCleaner.Views"
        Title="LensCleaner"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        FontFamily="{StaticResource 'JetBrains Mono'}">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:ChooseFolderViewModel">
            <Button HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Tapped="OpenFolderDialog">
                Choose a folder
            </Button>
        </DataTemplate>

        <DataTemplate DataType="vm:SortingViewModel">
            <views:SortingView />
        </DataTemplate>
    </Window.DataTemplates>

    <ContentControl Content="{Binding CurrentPage}" />
</Window>
